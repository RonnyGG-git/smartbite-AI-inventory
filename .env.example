# Copia este archivo como .env y coloca tu clave real. .env NUNCA se sube a Git ni al ZIP.
# Sin clave la app funciona igual: el chat responde con el análisis por reglas.

# Proveedor configurado: Google Gemini (endpoint compatible con OpenAI).
# Clave en https://aistudio.google.com/apikey
OPENAI_API_KEY=TU_API_KEY_AQUI
OPENAI_MODEL=gemini-3.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# "none" = respuesta en ~3 s (sin razonamiento previo). Vacío con modelos que no lo admitan.
OPENAI_REASONING_EFFORT=none
# Modelo de respaldo si el principal agota su cuota (el plan gratuito da ~20 consultas/día por modelo).
OPENAI_MODEL_RESPALDO=gemini-3.1-flash-lite

# Para usar OpenAI en su lugar:
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=
#   OPENAI_REASONING_EFFORT=
#   OPENAI_MODEL_RESPALDO=
